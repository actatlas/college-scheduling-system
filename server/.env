# Copy to .env and adjust values
NODE_ENV=development
PORT=4000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=srcb_scheduler

# Auth (JWT)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS
# Allow both local dev ports or use '*' for development convenience
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

